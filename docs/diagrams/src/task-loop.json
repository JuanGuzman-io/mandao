  "spec": {
    "schema_version": 2,
    "diagram_type": "workflow",
    "meta": {
      "title": "How a task runs",
      "output": "task-loop.html",
      "quality_profile": "showcase",
      "legend": {
        "mode": "auto",
        "entries": {
          "backend": {
            "label": "Agent command: a model session"
          },
          "security": {
            "label": "A person approves or decides"
          },
          "messagebus": {
            "label": "mandao script: no tokens"
          },
          "database": {
            "label": "Files Mandao writes"
          },
          "external": {
            "label": "You, your situation"
          }
        }
      }
    },
    "lanes": [
      {
        "id": "leader",
        "label": "Leader (your session)"
      },
      {
        "id": "agents",
        "label": "Subagents, clean context"
      },
      {
        "id": "scripts",
        "label": "Scripts (no tokens)"
      },
      {
        "id": "stop",
        "label": "Escalation",
        "variant": "exception"
      }
    ],
    "mainPath": [
      "step",
      "red",
      "implementer",
      "gates",
      "reviewer",
      "commit"
    ],
    "nodes": [
      {
        "id": "step",
        "lane": "scripts",
        "col": 0,
        "type": "messagebus",
        "label": "mandao run step",
        "sublabel": "next action + brief",
        "width": 157
      },
      {
        "id": "red",
        "lane": "agents",
        "col": 1,
        "type": "backend",
        "label": "Tester / Implementer",
        "sublabel": "red tests first",
        "width": 164
      },
      {
        "id": "implementer",
        "lane": "agents",
        "col": 2,
        "type": "backend",
        "label": "Implementer",
        "sublabel": "tier of the task",
        "width": 136
      },
      {
        "id": "gates",
        "lane": "scripts",
        "col": 3,
        "type": "messagebus",
        "label": "mandao run gates",
        "sublabel": "lint, types, impacted tests",
        "width": 213
      },
      {
        "id": "reviewer",
        "lane": "agents",
        "col": 4,
        "type": "backend",
        "label": "Reviewer",
        "sublabel": "other model when available",
        "width": 206
      },
      {
        "id": "commit",
        "lane": "scripts",
        "col": 5,
        "type": "messagebus",
        "label": "mandao run commit",
        "sublabel": "one commit, never a push",
        "width": 192
      },
      {
        "id": "leader",
        "lane": "leader",
        "col": 0,
        "type": "backend",
        "label": "Leader",
        "sublabel": "checkpoints every step",
        "width": 178
      },
      {
        "id": "escalate",
        "lane": "stop",
        "col": 3,
        "type": "messagebus",
        "label": "Next tier up",
        "sublabel": "after 2 FAILs",
        "width": 132
      },
      {
        "id": "halt",
        "lane": "stop",
        "col": 5,
        "type": "security",
        "label": "HALT: you decide",
        "sublabel": "after 3 FAILs at strong",
        "width": 185
      }
    ],
    "edges": [
      {
        "id": "leader-step",
        "from": "leader",
        "to": "step"
      },
      {
        "id": "step-red",
        "from": "step",
        "to": "red",
        "label": "RED recorded"
      },
      {
        "id": "red-impl",
        "from": "red",
        "to": "implementer"
      },
      {
        "id": "impl-gates",
        "from": "implementer",
        "to": "gates",
        "label": "REPORTED"
      },
      {
        "id": "gates-review",
        "from": "gates",
        "to": "reviewer"
      },
      {
        "id": "review-commit",
        "from": "reviewer",
        "to": "commit",
        "label": "PASS"
      },
      {
        "id": "review-rework",
        "from": "reviewer",
        "to": "escalate",
        "label": "FAIL",
        "variant": "security",
        "role": "error"
      },
      {
        "id": "escalate-impl",
        "from": "escalate",
        "to": "implementer",
        "label": "rework",
        "variant": "dashed",
        "role": "return",
        "toSide": "bottom"
      },
      {
        "id": "escalate-halt",
        "from": "escalate",
        "to": "halt",
        "variant": "security",
        "role": "error"
      }
    ]
  }
}
