#!/bin/sh
# mandao: pre-commit gates (lint on staged files + typecheck). Installed by `npm ci` (scripts/install-hooks.mjs).
# Fast on purpose: the full suite runs in `npm run check` and in CI.
set -e
npx --no-install biome check --staged --no-errors-on-unmatched --files-ignore-unknown=true
npx --no-install tsc --noEmit
# Diagrams and their pages follow the commands, the code they read and docs/process-map.md (no Archify needed).
if git diff --cached --name-only | grep -qE '^(core/commands/|docs/process-map\.md|docs/diagrams/|src/(scripts/spec|spec/loop|schemas/common|cli/(approve|start))\.ts|scripts/diagrams/)'; then
  node scripts/diagrams/check.mjs
fi
