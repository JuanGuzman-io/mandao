{
  "name": "mandao",
  "version": "0.1.0",
  "description": "Spec-Driven Development for coding agents, across harnesses. Every command is a mandao.",
  "type": "module",
  "license": "MIT",
  "author": "Juan D. Guzmán",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JuanGuzman-io/mandao.git"
  },
  "homepage": "https://github.com/JuanGuzman-io/mandao#readme",
  "bugs": {
    "url": "https://github.com/JuanGuzman-io/mandao/issues"
  },
  "bin": {
    "mandao": "dist/cli.js"
  },
  "files": [
    "dist",
    "core"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "biome check",
    "format": "biome check --write",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm test",
    "changeset": "changeset",
    "release": "npm run build && changeset publish",
    "prepublishOnly": "npm run check && npm run build",
    "smoke": "node scripts/smoke.mjs"
  },
  "keywords": [
    "agents",
    "antigravity",
    "claude-code",
    "cli",
    "codex",
    "copilot",
    "opencode",
    "sdd",
    "spec-driven-development"
  ],
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "commander": "^15.0.0",
    "gray-matter": "^4.0.3",
    "semver": "^7.8.5",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@changesets/cli": "^3.0.3",
    "@types/node": "^22.20.5",
    "@types/semver": "^7.8.0",
    "tsup": "^9.0.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
